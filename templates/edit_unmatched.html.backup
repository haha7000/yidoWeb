{% extends "base.html" %}

{% block content %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            {% if duty_free_type == "shilla" %}
            신라 영수증 정보 수정
            {% else %}
            영수증 정보 수정
            {% endif %}
        </h2>
        <div>
            <span class="badge bg-info">사용자: {{ user.username }}</span>
            <span class="badge bg-warning ms-2" id="remaining-count">남은 영수증: 계산 중...</span>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">영수증 이미지</h5>
                    <div class="image-container">
                        {% if receipt.file_path %}
                        {% set filename = receipt.file_path.split('/')[-1] if '/' in receipt.file_path else receipt.file_path %}
                        <img class="receipt-image" id="receipt-image" 
                             src="/uploads/{{ filename }}" 
                             alt="Receipt Image" 
                             style="width: 100%; cursor: grab;">
                        {% else %}
                        <div class="text-center p-5 text-muted">
                            <i class="fas fa-receipt fa-3x mb-3"></i>
                            <p>이미지를 찾을 수 없습니다</p>
                        </div>
                        {% endif %}
                    </div>
                    <div class="zoom-controls text-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="zoomIn()">
                            <i class="fas fa-search-plus"></i> 확대
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="zoomOut()">
                            <i class="fas fa-search-minus"></i> 축소
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetZoom()">
                            <i class="fas fa-undo"></i> 초기화
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        {% if duty_free_type == "shilla" %}
                        영수증 및 여권 정보 수정
                        {% else %}
                        영수증 번호 수정
                        {% endif %}
                    </h5>
                    
                    {% if duty_free_type == "shilla" %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>현재 영수증 정보:</strong><br>
                        영수증 번호: <code>{{ receipt.receipt_number or '없음' }}</code><br>
                        여권번호: <strong>{{ receipt.passport_number or '없음' }}</strong>
                    </div>
                    {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>현재 영수증 번호:</strong> {{ receipt.receipt_number or '없음' }}
                    </div>
                    {% endif %}
                    
                    <!-- 에러/성공 메시지 표시 영역 -->
                    <div id="error-message" class="alert alert-danger" style="display: none;"></div>
                    <div id="success-message" class="alert alert-success" style="display: none;"></div>
                    
                    <form id="update-form" method="POST" action="/edit_unmatched/{{ receipt.id }}">
                        <div class="mb-3">
                            <label for="new_receipt_number" class="form-label">
                                영수증 번호 <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="new_receipt_number" 
                                   name="new_receipt_number" value="{{ receipt.receipt_number or '' }}" 
                                   required placeholder="정확한 영수증 번호를 입력하세요">
                            <div class="form-text">
                                {% if duty_free_type == "shilla" %}
                                신라 면세점 영수증 번호 (13자리 숫자)
                                {% else %}
                                롯데 면세점 영수증 번호 (14자리 숫자)
                                {% endif %}
                            </div>
                        </div>
                        
                        {% if duty_free_type == "shilla" %}
                        <div class="mb-3">
                            <label for="passport_number" class="form-label">
                                여권번호 
                                <small class="text-muted">(선택사항)</small>
                            </label>
                            <input type="text" class="form-control" id="passport_number" 
                                   name="passport_number" value="{{ receipt.passport_number or '' }}" 
                                   placeholder="여권번호 입력 (예: AS1234567)">
                            <div class="form-text">
                                여권번호는 9자리 (영문 1-2글자 + 숫자 7-8글자) 형식입니다.<br>
                                영수증에서 여권번호가 인식되지 않았거나 잘못 인식된 경우 수정하세요.
                            </div>
                        </div>
                        
                        <!-- 매칭 가능한 여권 목록 표시 -->
                        <div class="mb-3" id="passport-suggestions" style="display: none;">
                            <label class="form-label">매칭 가능한 여권 목록</label>
                            <div class="card bg-light">
                                <div class="card-body">
                                    <small class="text-muted">아래 여권 중 하나를 선택하여 입력하세요:</small>
                                    <div id="passport-list"></div>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success" id="save-btn">
                                <i class="fas fa-check"></i> 저장 및 다음으로
                            </button>
                            <button type="button" class="btn btn-outline-warning" onclick="skipToNext()" id="skip-btn">
                                <i class="fas fa-forward"></i> 건너뛰고 다음으로
                            </button>
                            <a href="/result/" class="btn btn-outline-secondary">
                                <i class="fas fa-chart-bar"></i> 결과 페이지로
                            </a>
                        </div>
                    </form>
                    
                    {% if duty_free_type == "shilla" %}
                    <!-- 신라 전용 도움말 -->
                    <div class="mt-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-lightbulb text-warning"></i> 도움말
                                </h6>
                                <ul class="mb-0 small">
                                    <li>영수증 번호만 수정하면 엑셀 데이터와 매칭됩니다</li>
                                    <li>여권번호도 함께 수정하면 여권 정보와 연결됩니다</li>
                                    <li>여권번호가 정확하지 않으면 나중에 개별 수정 가능합니다</li>
                                    <li>엑셀 데이터에 없는 영수증 번호는 매칭되지 않습니다</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <!-- 매칭되지 않은 영수증 리스트 -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> 매칭되지 않은 영수증 목록
                        <span class="badge bg-warning text-dark ms-2" id="total-unmatched">로딩 중...</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="30%">영수증 번호</th>
                                    {% if duty_free_type == "shilla" %}
                                    <th width="25%">여권번호</th>
                                    {% endif %}
                                    <th width="20%">상태</th>
                                    <th width="{% if duty_free_type == 'shilla' %}20{% else %}45{% endif %}%">작업</th>
                                </tr>
                            </thead>
                            <tbody id="unmatched-list">
                                <tr>
                                    <td colspan="{% if duty_free_type == 'shilla' %}5{% else %}4{% endif %}" class="text-center p-3">
                                        <div class="spinner-border spinner-border-sm" role="status">
                                            <span class="visually-hidden">로딩 중...</span>
                                        </div>
                                        매칭되지 않은 영수증 목록을 불러오는 중...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.passport-option {
    border: 1px solid #dee2e6;
    border-radius: 5px;
    padding: 10px;
    margin-top: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.passport-option:hover {
    background-color: #e9ecef;
    border-color: #007bff;
}

.passport-option.selected {
    background-color: #d4edda;
    border-color: #28a745;
}

.input-error {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}

.input-success {
    border-color: #28a745 !important;
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25) !important;
}

.table-warning {
    background-color: rgba(255, 193, 7, 0.2) !important;
}

.sticky-top {
    position: sticky;
    top: 0;
    z-index: 10;
}
</style>

<script>
let currentReceiptId = {{ receipt.id }};
let dutyFreeType = "{{ duty_free_type }}";

document.addEventListener('DOMContentLoaded', function() {
    loadUnmatchedReceipts();
    
    // 신라 면세점인 경우에만 여권 관련 기능 활성화
    if (dutyFreeType === "shilla") {
        loadAvailablePassports();
        setupPassportValidation();
    }
    
    setupFormSubmission();
});

// 매칭되지 않은 영수증 목록 로드
async function loadUnmatchedReceipts() {
    try {
        const response = await fetch(`/api/next-unmatched-receipt/?current_id=0`);
        const data = await response.json();
        
        // 실제로는 모든 매칭되지 않은 영수증을 가져와야 하므로 별도 API 필요
        // 임시로 현재 영수증 정보만 표시
        const tbody = document.getElementById('unmatched-list');
        tbody.innerHTML = `
            <tr class="table-warning">
                <td>1</td>
                <td><code>{{ receipt.receipt_number or '없음' }}</code></td>
                ${dutyFreeType === "shilla" ? '<td><code>{{ receipt.passport_number or "없음" }}</code></td>' : ''}
                <td><span class="badge bg-warning text-dark">현재 편집 중</span></td>
                <td><i class="fas fa-edit text-warning"></i></td>
            </tr>
        `;
        
        document.getElementById('total-unmatched').textContent = '1개 (현재 항목)';
        document.getElementById('remaining-count').textContent = '남은 영수증: 계산 중...';
        
    } catch (error) {
        console.error('매칭되지 않은 영수증 목록 로드 오류:', error);
        document.getElementById('unmatched-list').innerHTML = `
            <tr>
                <td colspan="${dutyFreeType === 'shilla' ? '5' : '4'}" class="text-center p-3 text-danger">
                    <i class="fas fa-exclamation-triangle"></i> 목록을 불러오는 중 오류가 발생했습니다.
                </td>
            </tr>
        `;
    }
}

// 다음 영수증으로 건너뛰기
async function skipToNext() {
    try {
        const response = await fetch(`/api/next-unmatched-receipt/?current_id=${currentReceiptId}`);
        const data = await response.json();
        
        if (data.next_receipt) {
            window.location.href = `/edit_unmatched/${data.next_receipt.id}`;
        } else {
            showSuccess('모든 영수증 처리가 완료되었습니다!');
            setTimeout(() => {
                window.location.href = '/result/';
            }, 1500);
        }
    } catch (error) {
        console.error('다음 영수증 조회 오류:', error);
        showError('다음 영수증을 찾는 중 오류가 발생했습니다.');
    }
}

// 매칭 가능한 여권 목록 로드
async function loadAvailablePassports() {
    try {
        const response = await fetch('/api/available-passports/');
        if (response.ok) {
            const data = await response.json();
            if (data.passports && data.passports.length > 0) {
                displayPassportSuggestions(data.passports);
            }
        } else {
            console.error('여권 목록 로드 실패:', response.status);
        }
    } catch (error) {
        console.error('여권 목록 로드 오류:', error);
    }
}

// 여권 제안 목록 표시
function displayPassportSuggestions(passports) {
    const suggestionsDiv = document.getElementById('passport-suggestions');
    const passportList = document.getElementById('passport-list');
    
    passportList.innerHTML = '';
    
    passports.forEach(passport => {
        const div = document.createElement('div');
        div.className = 'passport-option';
        div.innerHTML = `
            <strong>${passport.name}</strong><br>
            <small>여권번호: <code>${passport.passport_number}</code></small><br>
            <small>생년월일: ${passport.birthday}</small>
        `;
        
        div.addEventListener('click', function() {
            selectPassport(passport.passport_number, passport.name);
        });
        
        passportList.appendChild(div);
    });
    
    suggestionsDiv.style.display = 'block';
}

// 여권 선택 함수
function selectPassport(passportNumber, name) {
    document.getElementById('passport_number').value = passportNumber;
    
    // 모든 옵션에서 selected 클래스 제거
    document.querySelectorAll('.passport-option').forEach(option => {
        option.classList.remove('selected');
    });
    
    // 선택된 옵션에 selected 클래스 추가
    event.target.classList.add('selected');
    
    // 성공 메시지 표시
    showSuccess(`선택됨: ${name} (${passportNumber})`);
    
    // 입력 필드 스타일 업데이트
    document.getElementById('passport_number').classList.remove('input-error');
    document.getElementById('passport_number').classList.add('input-success');
}

// 여권번호 유효성 검사 설정
function setupPassportValidation() {
    const passportInput = document.getElementById('passport_number');
    
    passportInput.addEventListener('input', function() {
        const value = this.value.trim();
        
        if (value === '') {
            // 빈 값은 허용 (선택사항이므로)
            this.classList.remove('input-error', 'input-success');
            return;
        }
        
        // 여권번호 형식 검증 (간단한 검증)
        const passportRegex = /^[A-Z]{1,2}\d{7,8}$/;
        if (passportRegex.test(value)) {
            this.classList.remove('input-error');
            this.classList.add('input-success');
            clearError();
        } else {
            this.classList.remove('input-success');
            this.classList.add('input-error');
            showError('올바른 여권번호 형식이 아닙니다. (예: AS1234567)');
        }
    });
}

// 폼 제출 처리
function setupFormSubmission() {
    document.getElementById('update-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        clearError();
        clearSuccess();

        const receiptInput = document.querySelector('input[name="new_receipt_number"]');
        const passportInput = document.querySelector('input[name="passport_number"]');
        
        const receiptNumber = receiptInput.value.trim();
        const passportNumber = passportInput ? passportInput.value.trim() : '';
        
        // 영수증 번호 유효성 검사
        if (!receiptNumber) {
            showError('영수증 번호를 입력해주세요.');
            receiptInput.classList.add('input-error');
            return;
        }

        // 신라 면세점인 경우 여권번호 추가 검증
        if (dutyFreeType === "shilla" && passportNumber) {
            const passportRegex = /^[A-Z]{1,2}\d{7,8}$/;
            if (!passportRegex.test(passportNumber)) {
                showError('올바른 여권번호 형식이 아닙니다. (예: AS1234567)');
                passportInput.classList.add('input-error');
                return;
            }
        }

        receiptInput.classList.remove('input-error');
        if (passportInput) passportInput.classList.remove('input-error');
        
        // 버튼 비활성화
        const saveBtn = document.getElementById('save-btn');
        const skipBtn = document.getElementById('skip-btn');
        saveBtn.disabled = true;
        skipBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 저장 중...';
        
        const formData = new FormData(this);
        
        try {
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                showSuccess('영수증 정보가 저장되었습니다. 다음 영수증으로 이동합니다...');
                
                // 1초 후 자동 리다이렉트 (서버에서 이미 처리됨)
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                // 오류 처리
                const contentType = response.headers.get('Content-Type');
                let errorMessage = '오류가 발생했습니다.';
                
                if (contentType && contentType.includes('application/json')) {
                    const result = await response.json();
                    errorMessage = result.error || result.detail || errorMessage;
                } else {
                    errorMessage = `서버 오류 (${response.status})`;
                }
                
                showError(errorMessage);
                receiptInput.classList.add('input-error');
            }
        } catch (error) {
            console.error('Error updating receipt:', error);
            showError('네트워크 오류가 발생했습니다.');
            receiptInput.classList.add('input-error');
        } finally {
            // 버튼 복원
            saveBtn.disabled = false;
            skipBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-check"></i> 저장 및 다음으로';
        }
    });
}

// 에러 메시지 표시
function showError(message) {
    const errorDiv = document.getElementById('error-message');
    if (errorDiv) {
        errorDiv.style.display = 'block';
        errorDiv.textContent = message;
        
        setTimeout(() => {
            errorDiv.style.display = 'none';
        }, 5000);
    }
}

// 에러 메시지 숨김
function clearError() {
    const errorDiv = document.getElementById('error-message');
    if (errorDiv) {
        errorDiv.style.display = 'none';
        errorDiv.textContent = '';
    }
}

// 성공 메시지 표시
function showSuccess(message) {
    const successDiv = document.getElementById('success-message');
    if (successDiv) {
        successDiv.style.display = 'block';
        successDiv.textContent = message;
        
        setTimeout(() => {
            successDiv.style.display = 'none';
        }, 3000);
    }
}

// 성공 메시지 숨김
function clearSuccess() {
    const successDiv = document.getElementById('success-message');
    if (successDiv) {
        successDiv.style.display = 'none';
        successDiv.textContent = '';
    }
}
</script>
{% endblock %}